# Python (existing Gradio app)
.venv/
__pycache__/
*.pyc
*.csv
/tmp/
sourceborn_paper/

# Node (Sourceborn SB-URR)
node_modules/
.env
uploads/*
!uploads/.gitkeep
npm-debug.log*

# generated backtest reports (sent to user, not source)
*.xlsx

# committed datasets (data/ is durable, versioned)
!data/*.csv
!data/index_constituents/*.csv
!data/*.xlsx
!data/history_15stock_raw/*.csv
!data/history_15stock/*.csv
docs/param_search_v1_progress.jsonl
!data/universe_snapshots/*.csv
!research/chityy_archive/*.csv
!research/chityy_archive/trigger_layer_v0_2/*.csv
# AUDIT FIX C6 (2026-08-09): the global *.csv/*.xlsx ignores silently excluded
# the owner's trigger-layer CSVs from every clone and deploy (found via CI on
# 2026-08-08). Research/docs/scripts artifacts are small and load-bearing —
# never silently untracked again. Big data stays out via the data/ rules.
!docs/**/*.csv
!docs/**/*.jsonl
!research/**/*.csv
!scripts/**/*.csv
!data/fii_dii_daily_2014_2023.csv
!data/india_10y_bond_yield.csv
!data/chityy/*.csv
